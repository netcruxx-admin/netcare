# Copy to .env and adjust as needed.
#
# Postgres (dev and prod). Local Homebrew Postgres with trust auth:
DATABASE_URL=postgresql+psycopg://localhost:5432/medicare
# Example with credentials (prod):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/medicare
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# Comma-separated list of allowed frontend origins. Subdomains of localhost
# (e.g. http://sunrise.localhost:3000) are also allowed automatically.
CORS_ORIGINS=http://localhost:3000
