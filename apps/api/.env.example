# Copy to .env and adjust as needed.
#
# Postgres (dev and prod). Local Homebrew Postgres with trust auth:
DATABASE_URL=postgresql+psycopg://localhost:5432/medicare
# Example with credentials (prod):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/medicare
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# Access tokens are short because a JWT cannot be recalled — this is the longest
# a revoked sign-in can keep working. The client renews silently, so shortening
# it costs nothing a user can feel.
ACCESS_TOKEN_MINUTES=15
# How long a sign-in survives without re-entering a password. Safe to make long:
# the refresh token behind it IS revocable (see app/sessions.py), unlike the
# seven-day access token this replaced.
REFRESH_TOKEN_DAYS=7

# Failed sign-ins tolerated from one address, per account and overall, within
# the window. Both are scoped to the source address so a remote attacker cannot
# lock a real user out of their own account by failing on purpose.
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW_MINUTES=15
# Comma-separated list of allowed frontend origins. In development, subdomains
# of localhost (e.g. http://sunrise.localhost:3000) are also allowed
# automatically; in production this list is the only thing accepted, so name
# every real tenant origin here.
CORS_ORIGINS=http://localhost:3000

# "development" or "production". Production turns off three dev conveniences:
#   * the X-Hospital-Id override on pre-login requests (attacker-controlled —
#     it would let anyone sign up inside any hospital)
#   * the fallback to DEFAULT_HOSPITAL_ID for an unrecognised host
#   * the *.localhost CORS regex
# It also refuses to boot on the demo JWT_SECRET / SUPERADMIN_PASSWORD below.
ENVIRONMENT=development

# Platform superadmin, created on first boot. MUST be changed for production —
# the demo password is published in this repo and grants cross-tenant access to
# every hospital's records.
SUPERADMIN_EMAIL=superadmin@platform.com
SUPERADMIN_PASSWORD=password123
