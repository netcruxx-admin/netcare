# Copy to .env and adjust as needed.
#
# Postgres (dev and prod). Local Homebrew Postgres with trust auth:
DATABASE_URL=postgresql+psycopg://localhost:5432/medicare
# Example with credentials (prod):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/medicare
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# Access tokens are short because a JWT cannot be recalled — this is the longest
# a revoked sign-in can keep working. The client renews silently, so shortening
# it costs nothing a user can feel.
ACCESS_TOKEN_MINUTES=15
# How long a sign-in survives without re-entering a password. Safe to make long:
# the refresh token behind it IS revocable (see app/sessions.py), unlike the
# seven-day access token this replaced.
REFRESH_TOKEN_DAYS=7

# Failed sign-ins tolerated from one address, per account and overall, within
# the window. Both are scoped to the source address so a remote attacker cannot
# lock a real user out of their own account by failing on purpose.
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW_MINUTES=15
# Comma-separated list of allowed frontend origins. In development, subdomains
# of localhost (e.g. http://sunrise.localhost:3000) are also allowed
# automatically; in production this list is the only thing accepted, so name
# every real tenant origin here.
CORS_ORIGINS=http://localhost:3000

# "development" or "production". Production turns off three dev conveniences:
#   * the X-Hospital-Id override on pre-login requests (attacker-controlled —
#     it would let anyone sign up inside any hospital)
#   * the fallback to DEFAULT_HOSPITAL_ID for an unrecognised host
#   * the *.localhost CORS regex
# It also refuses to boot on the demo JWT_SECRET / SUPERADMIN_PASSWORD below.
ENVIRONMENT=development

# Platform superadmin, created on first boot. MUST be changed for production —
# the demo password is published in this repo and grants cross-tenant access to
# every hospital's records.
SUPERADMIN_EMAIL=netcruxx@platform.com
SUPERADMIN_PASSWORD=password123

# Where uploaded hospital registration documents are written, and the URL prefix
# they are served back under. Local disk is a development affordance only: the
# files do not survive a container restart and a second instance cannot see the
# first one's uploads. Point this at object storage before deploying — the seam
# is app/storage.py.
UPLOAD_DIR=uploads
FILES_URL_PREFIX=/files
MAX_UPLOAD_MB=10

# Which implementation of that seam is live: "local" or "r2".
STORAGE_BACKEND=local

# --- Cloudflare R2 (only read when STORAGE_BACKEND=r2) ---
# Create the bucket in the Cloudflare dashboard, then an R2 API token scoped to
# it with "Object Read & Write". The token gives you the two keys below; the
# account id is in the R2 sidebar.
#
# Keep the bucket PRIVATE. Every link the API hands out is signed on the way
# out and expires — that is the point, for scans of medical licences and PAN
# cards. Do not attach a public custom domain unless you have decided these
# documents may be read by anyone holding the URL.
# R2_ACCOUNT_ID=
# R2_BUCKET=carbonhealth-documents
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Override only for a jurisdiction-specific endpoint; otherwise it is derived
# from the account id.
# R2_ENDPOINT=
# Set ONLY for a bucket deliberately published on a custom domain. When set,
# links are NOT signed.
# R2_PUBLIC_BASE_URL=
# How long a signed link stays good, in seconds.
# R2_SIGNED_URL_TTL_SECONDS=900

# --- Email (password reset) ---
# Uses Python stdlib smtplib — no paid service required.
# Works with Gmail free SMTP:
#   1. Enable 2-Step Verification on your Google account.
#   2. Go to myaccount.google.com/apppasswords → create an App Password for Mail.
#   3. Fill in the four vars below with your Gmail address and the 16-char app password.
# Leave SMTP_HOST empty in development; the reset link is printed to the server console.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM=NetCare <you@gmail.com>
# SMTP_USE_TLS=true

# --- Razorpay payment gateway ---
# Get from Razorpay dashboard → Settings → API Keys.
# rzp_test_* keys work without real money; safe in development.
# Leave empty to disable the online-payment flow (cash still works without them).
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
