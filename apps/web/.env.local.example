NEXT_PUBLIC_API_URL=http://localhost:8000

# The platform's own domain, with no tenant label. Tenants live one level below
# it (hospA.netcare.co.in), so this is what tells the app that netcare.co.in
# itself is the operator's front door and not a hospital called "netcare".
# Leave unset for local development, where "localhost" is unambiguous.
NEXT_PUBLIC_ROOT_DOMAIN=netcare.co.in

# Razorpay — no frontend env var needed.
# The key_id is returned by POST /payments/initiate so it stays server-side.
# Set RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET in apps/api/.env instead.

# Firebase / FCM — push notifications
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
